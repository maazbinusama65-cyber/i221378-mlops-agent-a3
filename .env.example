# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- LLM (any OpenAI-compatible API with tool calling) ---
LLM_PROVIDER=groq                 # groq | openai | gemini | openrouter
GROQ_API_KEY=                     # provider key (read from the environment only)
LLM_MODEL=openai/gpt-oss-120b

# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Airflow 3 (JWT login) ---
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=                 # must match AIRFLOW_ADMIN_PASSWORD used by docker compose
AIRFLOW_ADMIN_PASSWORD=           # compose: local Airflow admin password

# --- Kubernetes (restricted kubeconfig, approved namespace only) ---
KUBECONFIG=infra/kubeconfig.yaml
AGENT_K8S_NAMESPACES=mlops-agent

# --- Agent policy ---
AGENT_APPROVED_DAGS=churn_training_pipeline
AGENT_MAX_MODEL_AGE_DAYS=30
AGENT_TOOL_TIMEOUT_S=30
